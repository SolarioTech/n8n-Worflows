    {
      "parameters": {
        "jsCode": "// Generate weekly project status summary from metrics data\nconst metricsData = $input.all();\n\n// Extract metrics from the input\nlet totalProjects = 0;\nlet completedProjects = 0;\nlet delayedProjects = 0;\nlet averageCompletion = 0;\n\n// Process the metrics data\nif (metricsData && metricsData.length > 0) {\n  const metrics = metricsData[0].json;\n  \n  // Extract metrics using correct field names from Calculate Project Metrics node\n  totalProjects = metrics['count_Task_Completion_(%)'] || 0;\n  delayedProjects = metrics['count_Is_Delayed'] || 0;\n  averageCompletion = Math.round(metrics['average_Task_Completion_(%)'] || 0);\n  \n  // Calculate completed projects (those with Task Completion >= 95)\n  // Access the original data to count completed projects\n  const fetchData = $('Fetch Project Data').all();\n  completedProjects = fetchData.filter(item => {\n    const taskCompletion = item.json['Task Completion (%)'];\n    return taskCompletion !== null && taskCompletion !== undefined && taskCompletion >= 95;\n  }).length;\n}\n\n// Generate the summary text\nconst summaryText = `Weekly Project Status Report\n\n📊 Project Overview:\n- Total Projects: ${totalProjects}\n- Completed Projects: ${completedProjects}\n- Delayed Projects: ${delayedProjects}\n- Overall Completion: ${averageCompletion}%\n\n${delayedProjects > 0 ? '⚠️ Attention Required: ' + delayedProjects + ' project(s) are currently delayed.' : '✅ All projects are on track.'}\n\nThis is an automated weekly status report generated on ${new Date().toLocaleDateString()}.`;\n\n// Return the summary with all metric fields\nreturn [{\n  json: {\n    summaryText: summaryText,\n    totalProjects: totalProjects,\n    completedProjects: completedProjects,\n    delayedProjects: delayedProjects,\n    averageCompletion: averageCompletion,\n    reportDate: new Date().toISOString()\n  }\n}];"
      },
